{
  "name": "@user/claude-cli-usage",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/status/main.js --target browser --format iife --outfile status/main.js --minify"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "claude-cli-usage",
        "name": "Claude CLI",
        "icon": "pulse"
      },
      "statusSection": {
        "entry": "status/index.html",
        "height": 76,
        "title": "Claude usage",
        "defaultExpanded": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "quota"
        ],
        "permissions": {
          "exec": [
            "claude"
          ]
        }
      },
      "quota": {
        "providers": []
      }
    }
  }
}
