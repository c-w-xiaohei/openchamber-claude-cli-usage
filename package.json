{
  "name": "@user/claude-cli-usage",
  "version": "1.1.0",
  "private": true,
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "claude-cli-usage",
        "name": "Claude CLI",
        "icon": "pulse",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "source": {
          "path": "/status",
          "interval": 60000
        },
        "title": "Claude usage",
        "defaultExpanded": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "quota"
        ],
        "permissions": {
          "exec": [
            "claude"
          ]
        }
      },
      "quota": {
        "providers": []
      }
    }
  }
}
